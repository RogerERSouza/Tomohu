# Ambiente aceito: development, test ou production.
TOMOHU_ENVIRONMENT=development

# Origens do frontend autorizadas a chamar a API, separadas por vírgula.
TOMOHU_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# PostgreSQL para desenvolvimento local pelo Docker Compose.
TOMOHU_DATABASE_URL=postgresql+psycopg://tomohu:tomohu@localhost:5432/tomohu

# Sem login, esta API só deve aceitar cadernos anônimos localmente.
TOMOHU_ALLOW_ANONYMOUS_NOTEBOOKS=true
