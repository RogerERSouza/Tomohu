# Local development; production requires an explicit secret and HTTPS CORS origins.
TOMOHU_ENVIRONMENT=development
TOMOHU_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
TOMOHU_DATABASE_URL=postgresql+psycopg://tomohu:tomohu@localhost:5432/tomohu

# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
# Never commit the generated value. Empty is allowed only in development/test.
TOMOHU_JWT_SECRET=
TOMOHU_ACCESS_TOKEN_MINUTES=15

# Required for working email links: set the SAME generated JWT secret for API/worker.
# Frontend URL includes the deployment base path, e.g. https://example.com/Tomohu/.
TOMOHU_FRONTEND_URL=http://localhost:5173/
# outbox writes private .eml files under backend/.outbox; never serves them over HTTP.
TOMOHU_MAIL_MODE=outbox
# Production: smtp, authenticated STARTTLS on port 587 (not implicit TLS/465).
TOMOHU_SMTP_HOST=
TOMOHU_SMTP_PORT=587
TOMOHU_SMTP_USERNAME=
TOMOHU_SMTP_PASSWORD=
TOMOHU_MAIL_FROM=Tomohu <noreply@example.com>
